# .claude/ is local-only except what the repo deliberately ships: the
# exam-refill skill, and the guard that stops an agent destroying main.
# settings.json is the SHARED project file and carries only the hook wiring;
# personal permissions and plugins belong in settings.local.json, which stays
# ignored — this repo is public and those plugin names are protected strings.
.claude/*
!.claude/skills/
.claude/skills/*
!.claude/skills/exam-refill/
!.claude/hooks/
!.claude/settings.json
